{
	"id": null,
	"uid": "wikiteq-mediawiki-statistics",
	"title": "MediaWiki statistics",
	"description": "Statistics from clockworksoul/mediawiki_exporter via wiki-exporter ServiceMonitor | Select a Prometheus data source, namespace and service | All metrics are gauges updated every minute | Replica values use max to avoid double counting | Missing series remain gaps | Requires Prometheus Operator namespace and service labels",
	"tags": [
		"mediawiki",
		"wikiteq",
		"prometheus"
	],
	"timezone": "browser",
	"schemaVersion": 39,
	"version": 1,
	"editable": true,
	"refresh": "1m",
	"time": {
		"from": "now-24h",
		"to": "now"
	},
	"timepicker": {
		"refresh_intervals": [
			"1m",
			"5m",
			"15m",
			"30m",
			"1h"
		]
	},
	"links": [
		{
			"title": "Exporter source",
			"type": "link",
			"url": "https://github.com/clockworksoul/mediawiki_exporter",
			"targetBlank": true
		}
	],
	"templating": {
		"list": [
			{
				"name": "datasource",
				"label": "Prometheus",
				"type": "datasource",
				"query": "prometheus",
				"refresh": 1,
				"options": []
			},
			{
				"name": "namespace",
				"label": "Namespace",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "${datasource}"
				},
				"definition": "label_values(mediawiki_statistics_pages, namespace)",
				"query": {
					"query": "label_values(mediawiki_statistics_pages, namespace)",
					"refId": "StandardVariableQuery"
				},
				"refresh": 1,
				"sort": 1,
				"multi": true,
				"includeAll": true,
				"allValue": ".*",
				"current": {
					"text": "All",
					"value": "$__all"
				},
				"options": []
			},
			{
				"name": "service",
				"label": "Service",
				"type": "query",
				"datasource": {
					"type": "prometheus",
					"uid": "${datasource}"
				},
				"definition": "label_values(mediawiki_statistics_pages{namespace=~\"${namespace:regex}\"}, service)",
				"query": {
					"query": "label_values(mediawiki_statistics_pages{namespace=~\"${namespace:regex}\"}, service)",
					"refId": "StandardVariableQuery"
				},
				"refresh": 1,
				"sort": 1,
				"multi": true,
				"includeAll": true,
				"allValue": ".*",
				"current": {
					"text": "All",
					"value": "$__all"
				},
				"options": []
			}
		]
	},
	"panels": [
		{
			"id": 1,
			"type": "stat",
			"title": "Articles",
			"description": "Current wiki articles count, deduplicated across exporter replicas",
			"datasource": {
				"type": "prometheus",
				"uid": "${datasource}"
			},
			"gridPos": {
				"h": 4,
				"w": 6,
				"x": 0,
				"y": 0
			},
			"targets": [
				{
					"refId": "A",
					"expr": "max by (namespace, service) (mediawiki_statistics_articles{namespace=~\"${namespace:regex}\",service=~\"${service:regex}\"})",
					"legendFormat": "Articles · {{namespace}} / {{service}}",
					"instant": true,
					"range": false,
					"editorMode": "code"
				}
			],
			"fieldConfig": {
				"defaults": {
					"unit": "short",
					"decimals": 0,
					"min": 0,
					"color": {
						"mode": "fixed",
						"fixedColor": "blue"
					},
					"noValue": "No data"
				},
				"overrides": []
			},
			"options": {
				"reduceOptions": {
					"calcs": [
						"lastNotNull"
					],
					"fields": "",
					"values": false
				},
				"orientation": "auto",
				"textMode": "auto",
				"colorMode": "value",
				"graphMode": "none",
				"justifyMode": "auto"
			}
		},
