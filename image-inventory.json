{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus data source",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "prometheus",
      "name": "Prometheus",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "id": 1,
      "title": "Container Images",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 12,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(sum by (namespace, pod, container, image) (kube_pod_container_info{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",image!=\"\"}), \"image_tag\", \"$2\", \"image\", \"^(.+):([^:@]+)(?:@.*)?$\")",
          "format": "table",
          "instant": true,
          "legendFormat": ""
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "pod": "Pod",
              "container": "Container",
              "image": "Image",
              "image_tag": "Tag"
            },
            "indexByName": {
              "namespace": 0,
              "pod": 1,
              "container": 2,
              "image": 3,
              "image_tag": 4
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "displayMode": "auto",
            "inspect": false
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      }
    },
    {
      "id": 2,
      "title": "Current Image Distribution",
      "type": "barchart",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (namespace, image) (kube_pod_container_info{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",image!=\"\"})",
          "format": "time_series",
          "instant": true,
          "legendFormat": "{{namespace}} / {{image}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "Containers",
            "axisPlacement": "left",
            "barAlignment": 0,
            "drawStyle": "bars",
            "fillOpacity": 80,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "xTickLabelRotation": 0,
        "xTickLabelSpacing": 0,
        "showValue": "auto",
        "barRadius": 0,
        "barWidthFactor": 0.6,
        "groupWidth": 0.7,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "single",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Image Versions Over Time",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 10,
        "w": 12,
        "x": 12,
        "y": 12
      },
      "targets": [
        {
          "refId": "A",
          "expr": "label_replace(sum by (namespace, image) (kube_pod_container_info{namespace=~\"$namespace\",pod=~\"$pod\",container!=\"\",image!=\"\"}), \"image_tag\", \"$2\", \"image\", \"^(.+):([^:@]+)(?:@.*)?$\")",
          "format": "time_series",
          "instant": false,
          "legendFormat": "{{namespace}} / {{image}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "lineWidth": 2,
            "fillOpacity": 15,
            "gradientMode": "none",
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisCenteredZero": false,
            "axisPlacement": "left"
          }
        },
        "overrides": []
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        }
      }
    }
  ],
  "schemaVersion": 39,
  "tags": [
    "kubernetes",
    "prometheus",
    "images",
    "containers"
  ],
  "templating": {
    "list": [
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(kube_pod_container_info, namespace)",
        "query": {
          "query": "label_values(kube_pod_container_info, namespace)",
          "refId": "StandardVariableQuery"
        },
        "includeAll": true,
        "multi": false,
        "refresh": 1,
        "sort": 1,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        },
        "allValue": ".*"
      },
      {
        "name": "pod",
        "label": "Pod(s)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS_PROMETHEUS}"
        },
        "definition": "label_values(kube_pod_container_info{namespace=~\"$namespace\"}, pod)",
        "query": {
          "query": "label_values(kube_pod_container_info{namespace=~\"$namespace\"}, pod)",
          "refId": "StandardVariableQuery"
        },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timezone": "",
  "title": "Kubernetes Container Image Inventory",
  "uid": "k8s-image-inventory",
  "version": 4
}
